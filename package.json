{
  "name": "notr",
  "productName": "notr",
  "version": "1.1.1",
  "description": "A tiny, always-on-top note app. Open it and you get a note.",
  "main": "src/main.js",
  "author": "T_J",
  "license": "MIT",
  "private": true,
  "homepage": "https://t-julsgaard.github.io/Notr/",
  "repository": {
    "type": "git",
    "url": "https://github.com/T-Julsgaard/Notr.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "web": "node scripts/build-web.js",
    "test": "node scripts/test.js"
  },
  "build": {
    "appId": "app.notr",
    "productName": "notr",
    "executableName": "notr",
    "files": [
      "src/**/*",
      "node_modules/@fontsource/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/notr.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "notr",
      "createStartMenuShortcut": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "installerIcon": "src/assets/notr.ico",
      "uninstallerIcon": "src/assets/notr.ico",
      "uninstallDisplayName": "notr",
      "include": "build/installer.nsh",
      "artifactName": "notr-setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "notr-${version}-mac.${ext}"
    },
    "dmg": {
      "title": "notr"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "synopsis": "A tiny, always-on-top note app",
      "maintainer": "T-Julsgaard <T-Julsgaard@users.noreply.github.com>",
      "executableName": "notr"
    },
    "appImage": {
      "artifactName": "notr-${version}-linux-x86_64.${ext}"
    },
    "deb": {
      "artifactName": "notr-${version}-linux-amd64.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/martian-mono": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@fontsource/vt323": "^5.3.0"
  }
}
