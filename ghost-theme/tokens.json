{
  "name": "ghost",
  "source": "Notr src/themes.css (05 ghost) + src/note.css",
  "font": {
    "family": "DM Mono",
    "stack": "'DM Mono', ui-monospace, monospace",
    "weights": { "body": 300, "available": [300, 400, 500], "italic": [300, 400] },
    "note": "Bold (700) is not shipped; the browser synthesises it from 500."
  },
  "size": {
    "content": "13px",
    "lineHeight": 1.8,
    "title": "10px",
    "status": "10px",
    "menu": "12px"
  },
  "color": {
    "bg": "#111111",
    "bar": "transparent",
    "menuBg": "#161616",
    "menuHover": "#1f1f1f",
    "hover": "transparent",
    "border": "#2a2a2a",
    "borderFocus": "#333333",
    "divider": "#1d1d1d",
    "menuBorder": "#2a2a2a",
    "text": "#d6d6d6",
    "strong": "#ffffff",
    "dim": "#8a8a8a",
    "label": "#8a8a8a",
    "accent": "#d6d6d6",
    "btn": "#8a8a8a",
    "btnHover": "#ffffff",
    "danger": "#ff7a6b",
    "selection": "rgba(255, 255, 255, .14)",
    "swatch": "#8a8a8a",
    "menuShadow": "0 12px 30px rgba(0, 0, 0, .55)"
  },
  "layout": {
    "contentPadding": "6px 18px",
    "barHeight": "30px",
    "statusHeight": "22px",
    "menuRowPadding": "5px 12px",
    "menuMinWidth": "190px",
    "iconButton": { "height": "24px", "minWidth": "30px", "padding": "0 8px" },
    "frameBorder": "1px",
    "barBorder": "0",
    "statusBorder": "0",
    "radius": "0"
  },
  "motion": {
    "chromeFade": "250ms",
    "buttonColour": "120ms",
    "menuDrop": "120ms ease-out, from translateY(-4px) and opacity 0",
    "confirmRise": "140ms ease-out, from translateY(6px) and opacity 0",
    "windowFadeIn": "220ms, ease-out cubic, opacity 0 to 1",
    "windowSlideIn": "280ms, ease-out cubic, from 30% of the way along to the target, with opacity"
  },
  "window": {
    "frame": false,
    "backgroundColor": "#111111",
    "minSize": { "width": 200, "height": 150 },
    "defaultSize": { "width": 300, "height": 300 }
  }
}
